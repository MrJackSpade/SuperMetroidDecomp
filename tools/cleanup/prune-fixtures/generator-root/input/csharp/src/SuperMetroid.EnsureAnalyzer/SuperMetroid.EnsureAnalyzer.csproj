<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reachability prune fixture (tools/cleanup/check-prune-fixtures.ps1): the build-time analyzer, whose source
       generator no source names: the compiler constructs it, so the prune keeps it (#2614). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
