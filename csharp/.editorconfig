[*.cs]

# IDE0058: Expression value is never used
dotnet_diagnostic.IDE0058.severity = silent

# IDE0160: Convert to block scoped namespace
dotnet_diagnostic.IDE0160.severity = silent

# IDE2001: Embedded statements must be on their own line
dotnet_diagnostic.IDE2001.severity = silent

# IDE2003: Blank line required between block and subsequent statement
dotnet_diagnostic.IDE2003.severity = silent

# Project quality gates
#
# These diagnostics describe code shapes the project intentionally treats as
# build-breaking defects. Keeping the policy in this named data file makes the
# rule apply uniformly to every C# project without duplicating MSBuild lists.
# IDE0211 reports top-level statements only when they are not the preferred style.
csharp_style_prefer_top_level_statements = false
dotnet_diagnostic.IDE0211.severity = error
dotnet_diagnostic.CA1512.severity = error
dotnet_diagnostic.CA1822.severity = error
dotnet_diagnostic.CA1859.severity = error
dotnet_diagnostic.CA1826.severity = error
dotnet_diagnostic.IDE0032.severity = error
dotnet_diagnostic.IDE0060.severity = error
dotnet_diagnostic.IDE0078.severity = error
dotnet_diagnostic.SYSLIB1054.severity = error
# #627: a primitive switched over named constants is a closed domain; model it as a type.
dotnet_diagnostic.SME6270.severity = error
# #627: closed-domain switches handle every member and fail loudly on undefined values.
dotnet_diagnostic.SME6271.severity = error
# #627: a masked or shifted selector is decoded to its domain type before dispatch.
dotnet_diagnostic.SME6272.severity = error
# #627: an enum formatted with a numeric specifier throws; format its underlying value.
dotnet_diagnostic.SME6273.severity = error
# #627: a primitive compared against several named constants of one catalog is a closed domain.
dotnet_diagnostic.SME6274.severity = error
# #627: a primitive parameter only cast to a domain enum should take the enum or decode once.
dotnet_diagnostic.SME6275.severity = error
# #627: arithmetic or stepping must not manufacture an undefined closed-enum value.
dotnet_diagnostic.SME6276.severity = error
# #627: a domain value is not carried as a primitive through dedicated storage.
dotnet_diagnostic.SME6277.severity = error
# #627: storage written and compared only as a few literals is a closed state set.
dotnet_diagnostic.SME6278.severity = error
# #627: a masked local compared against several values is a hand-decoded selector.
dotnet_diagnostic.SME6279.severity = error
# #628: spatial values are typed, never parallel components, parameters or collections.
dotnet_diagnostic.SME6280.severity = error
dotnet_diagnostic.SME6281.severity = error
dotnet_diagnostic.SME6282.severity = error
dotnet_diagnostic.SME6283.severity = error
# #629: the CPU A-bus layout is confined to declared boundaries.
dotnet_diagnostic.SME6290.severity = error
dotnet_diagnostic.SME6291.severity = error
# #630: the PPU layout is confined to declared rendering boundaries.
dotnet_diagnostic.SME6300.severity = error
dotnet_diagnostic.SME6301.severity = error
# #631: S-DSP register layout is confined to the DSP and its typed controls.
dotnet_diagnostic.SME6310.severity = error
dotnet_diagnostic.SME6311.severity = error
# #632: SPC700 APU RAM and port layout is confined to the typed driver-memory views.
dotnet_diagnostic.SME6320.severity = error
dotnet_diagnostic.SME6321.severity = error
# #633: parameter lists stay within the ceiling and pass capabilities as narrow typed contracts.
dotnet_diagnostic.SME6330.severity = error
dotnet_diagnostic.SME6331.severity = error
dotnet_diagnostic.SME6332.severity = error

# #641 cartridge-encoding ratchet: files may only lose raw hex, pointer dispatch and opaque word arrays.
dotnet_diagnostic.SME6340.severity = error
dotnet_diagnostic.SME6341.severity = error
dotnet_diagnostic.SME6342.severity = error
dotnet_diagnostic.SME6343.severity = error
dotnet_diagnostic.SME6344.severity = error
# #223: shifts and masks by a storage width name their meaning.
dotnet_diagnostic.SME6345.severity = error
dotnet_diagnostic.IDE0330.severity = error

# #620/#677: reusable argument guards use Ensure; Ensure calls let it capture the value expression.
dotnet_diagnostic.SME6201.severity = error
dotnet_diagnostic.SME6202.severity = error

# #223: 16-bit and 24-bit values are read through the canonical word reads, not rebuilt from bytes.
dotnet_diagnostic.SME6350.severity = error
