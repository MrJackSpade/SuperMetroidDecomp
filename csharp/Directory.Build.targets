<Project>
  <PropertyGroup>
    <!-- #620 starts as advisory while existing guards are migrated. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);SME6201</WarningsNotAsErrors>
    <!-- #627 primitive-domain rules report the audit inventory until each rule reaches zero.
         SME6271 has reached zero; .editorconfig makes it an error. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);SME6270;SME6272</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'SuperMetroid.EnsureAnalyzer' and '$(MSBuildProjectName)' != 'SuperMetroid.EnsureVerification'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/SuperMetroid.EnsureAnalyzer/SuperMetroid.EnsureAnalyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
