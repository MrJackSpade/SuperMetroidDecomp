    { "name": "Presentation", "modules": ["Rendering"],
      "description": "Renders the simulation's published state." },
    { "name": "Runtime", "modules": ["Runtime"],
      "description": "The gameplay frame loop that composes the simulation, its attract-demo playback and the runtime's renderer and audio publication." },
    { "name": "Frontend", "modules": ["Frontend"],
      "description": "The game's state dispatcher, frontend screens and cinematics, and host options; it drives the runtime." }
