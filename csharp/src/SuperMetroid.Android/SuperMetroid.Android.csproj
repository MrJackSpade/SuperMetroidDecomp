<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.supermetroid.csharp.testing</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <!-- Reflection-based debugger graphs must remain available in testing builds. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Initial untrimmed testing baseline; profile before selecting an AOT strategy. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- The private debuggable APK uses dynamic JNI registration. LLVM marshal glue
         produced an onCreate UnsatisfiedLinkError with this SDK/device combination. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <DebugSymbols>true</DebugSymbols>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- adb install must work without Visual Studio's separate fast-deployment files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <!-- Opt-in device probes are excluded from normal player APKs. -->
    <Compile Include="../../tools/android-probes/AudioFocusProbe.cs" Condition="'$(AndroidHostProbes)' == 'true'" />
    <ProjectReference Include="../SuperMetroid.Core/SuperMetroid.Core.csproj" />
    <ProjectReference Include="../SuperMetroid.Diagnostics/SuperMetroid.Diagnostics.csproj" />
    <!-- Private, self-contained testing package; never publish this APK publicly. -->
    <AndroidAsset Include="../../../Super Metroid.smc" LogicalName="game/SuperMetroid.smc" />
    <AndroidAsset Include="../../../standalone-assets/audio/**/*" LogicalName="game/audio/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
