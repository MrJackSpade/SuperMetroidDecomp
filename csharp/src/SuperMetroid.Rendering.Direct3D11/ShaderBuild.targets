<Project>
  <PropertyGroup>
    <!-- Pin both SDK directory and compiler bytes; a serviced SDK must be reviewed explicitly. -->
    <ShaderCompiler>$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.0.26100.0\x64\fxc.exe</ShaderCompiler>
    <ShaderCompilerSha256>005EFF830845789C7EFB2831A0B41950EE6954E9BCD93BAF50DE67AD537728B2</ShaderCompilerSha256>
  </PropertyGroup>
  <Target Name="CompileDisplayShaders" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ShaderCompiler)')" Text="Install Windows SDK 10.0.26100.0 x64 shader compiler; see D3D11_BUILD.md." />
    <GetFileHash Files="$(ShaderCompiler)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="VerifiedShaderCompiler" />
    </GetFileHash>
    <Error Condition="'%(VerifiedShaderCompiler.FileHash)' != '$(ShaderCompilerSha256)'" Text="Shader compiler SHA256 differs from the reviewed build tool." />
    <MakeDir Directories="$(IntermediateOutputPath)Shaders" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T cs_5_0 /E TitleGradientMain /Fo &quot;$(IntermediateOutputPath)Shaders\TitleGradient.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\TitleGradient.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T cs_5_0 /E Main /Fo &quot;$(IntermediateOutputPath)Shaders\Solid.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Solid.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T cs_5_0 /E Main /Fo &quot;$(IntermediateOutputPath)Shaders\Tiles.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Tiles.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T vs_5_0 /E Vertex /Fo &quot;$(IntermediateOutputPath)Shaders\DisplayVertex.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Display.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T ps_5_0 /E Pixel /Fo &quot;$(IntermediateOutputPath)Shaders\DisplayPixel.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Display.hlsl&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\TitleGradient.cso" LogicalName="SuperMetroid.Shaders.TitleGradient.cso" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\DisplayVertex.cso" LogicalName="SuperMetroid.Shaders.DisplayVertex.cso" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\DisplayPixel.cso" LogicalName="SuperMetroid.Shaders.DisplayPixel.cso" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\Solid.cso" LogicalName="SuperMetroid.Shaders.Solid.cso" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\Tiles.cso" LogicalName="SuperMetroid.Shaders.Tiles.cso" />
    </ItemGroup>
  </Target>
</Project>
