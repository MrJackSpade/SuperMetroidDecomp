<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.supermetroid.csharp.testing</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <!-- Preserve compatibility with commands used during the original AOT investigation. -->
    <AndroidUseAot Condition="'$(AndroidUseAot)' == '' and '$(AndroidExperimentalAot)' != ''">$(AndroidExperimentalAot)</AndroidUseAot>
    <AndroidUseAot Condition="'$(AndroidUseAot)' == '' and '$(Configuration)' == 'Release'">true</AndroidUseAot>
    <AndroidUseAot Condition="'$(AndroidUseAot)' == ''">false</AndroidUseAot>
    <!-- Untrimmed fallback; rooted Release configuration below retains debugger graphs. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- The private debuggable APK uses dynamic JNI registration. LLVM marshal glue
         produced an onCreate UnsatisfiedLinkError with this SDK/device combination. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <DebugSymbols>true</DebugSymbols>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- adb install must work without Visual Studio's separate fast-deployment files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <!-- Device-tested non-profiled AOT, with all reflection-owned application declarations. -->
  <PropertyGroup Condition="'$(AndroidUseAot)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup Condition="'$(AndroidUseAot)' == 'true'">
    <TrimmerRootAssembly Include="SuperMetroid.Android" RootMode="All" />
    <TrimmerRootAssembly Include="SuperMetroid.Core" RootMode="All" />
    <TrimmerRootAssembly Include="SuperMetroid.Diagnostics" RootMode="All" />
    <TrimmerRootAssembly Include="SuperMetroid.AssetExtraction" RootMode="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Opt-in device probes are excluded from normal player APKs. -->
    <Compile Include="../../tools/android-probes/AudioFocusProbe.cs" Condition="'$(AndroidHostProbes)' == 'true'" />
    <ProjectReference Include="../SuperMetroid.Core/SuperMetroid.Core.csproj" />
    <ProjectReference Include="../SuperMetroid.Diagnostics/SuperMetroid.Diagnostics.csproj" />
    <ProjectReference Include="../SuperMetroid.AssetExtraction/SuperMetroid.AssetExtraction.csproj" />
  </ItemGroup>
</Project>
