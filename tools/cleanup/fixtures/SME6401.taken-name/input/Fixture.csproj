<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cleanup fixture (tools/cleanup/check-fixtures.ps1): the 2026-11-15 failure. The generic Behavior<TMotion> in
       MotionBehavior.cs shares its non-generic base's name, so the file name SME6401 wants (Behavior.cs) is taken. The
       fixer used to refuse and the run recorded the site as unfixed; a fix is always applied (#2599), so the type goes
       into Behavior.cs beside its base, deleting nothing, and MotionBehavior.cs and its item go. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(CleanupAnalyzer)" />
    <Analyzer Include="$(CleanupCodeFixes)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Behavior.cs" />
    <Compile Include="MotionBehavior.cs" />
  </ItemGroup>
</Project>
