<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Retain the console subsystem so managed and native startup failures are printed to the
      launching terminal instead of being reduced to focus-stealing Windows error dialogs.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SuperMetroid.Desktop/SuperMetroid.Desktop.csproj" />
  </ItemGroup>
</Project>
