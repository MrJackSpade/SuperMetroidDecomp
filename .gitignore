# This repository is intentionally private and self-contained for its owner's personal
# reverse-engineering workspace. The verified ROM and generated standalone-assets are
# versioned here by explicit request. Do not make the repository public or redistribute it.
__pycache__/
*.pyc
build/
out/

# Disposable IDE/compiler state.
.vs/
csharp/.vs/
csharp/**/bin/
csharp/**/obj/
csharp/**/altbin/
*.csproj.user
# Per-user battery-backed cartridge state written beside the private ROM. The old binary
# file remains a one-time migration source; JSON, atomic backups, and temporary writes are
# equally local playthrough state.
*.srm
*.save.json
*.save.json.bak
*.save.json.*.tmp
# Per-run controller journals can contain long private play sessions and are regenerated by
# the desktop host. Keep recordings available for local replay without committing them.
*.smrec
*.smrec.tmp
# Ad-hoc BaseOutputPath/BaseIntermediateOutputPath names used to evade IDE-held DLL locks
# during isolated regression builds. They are compiler products, never source artifacts.
csharp/**/.*-build/
csharp/**/.*-obj/

# Repeatable visual-audit output. Curated regression fixtures live under test-fixtures;
# these captures are regenerated on demand and must not dirty every verified commit.
csharp/test-temp/ceres-destruction-repro*/
csharp/test-temp/ceres-destruction-ticket*/
csharp/test-temp/door-transition-visual/
csharp/test-temp/input-replays/*.last.png
csharp/test-temp/save-station-ticket*/

# Separate reference checkouts/builds. Their reproducible origins and pinned revisions are
# documented in README.md; embedding their nested .git directories would create accidental
# gitlinks instead of a useful self-contained snapshot.
upstream-sm/
upstream-disassembly/
standalone-native/
