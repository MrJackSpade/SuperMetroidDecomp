<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSBuildWorkspace evaluates every project (Android included) in its own build host. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The partial-type analyzer and this audit share one generated-code test. -->
    <Compile Include="../SuperMetroid.EnsureAnalyzer/PartialTypeAnalyzer.cs" Link="Shared/PartialTypeAnalyzer.cs" />
    <Compile Include="../SuperMetroid.ReachabilityAudit/SolutionLoading/**/*.cs" LinkBase="SolutionLoading" />
  </ItemGroup>
  <Import Project="../../test-support/WindowsConsole.projitems" />
</Project>
