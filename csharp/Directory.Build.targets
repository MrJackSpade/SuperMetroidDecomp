<Project>
  <!-- Every project runs the source generators (debugger save states, the verification registry, the build identity,
       named members and generated text). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'SuperMetroid.Generators'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/SuperMetroid.Generators/SuperMetroid.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
