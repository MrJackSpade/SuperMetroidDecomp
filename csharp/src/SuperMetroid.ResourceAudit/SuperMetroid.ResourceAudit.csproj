<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SuperMetroid.Core/SuperMetroid.Core.csproj" />
    <ProjectReference Include="../SuperMetroid.Tooling/SuperMetroid.Tooling.csproj" />
    <ProjectReference Include="../SuperMetroid.AssetExtraction/SuperMetroid.AssetExtraction.csproj" />
    <!-- Use the compiler shipped with the SDK, not a downloaded parser package. -->
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="AuditResourceReferences" AfterTargets="Build" Condition="'$(RunResourceAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --root &quot;$(MSBuildProjectDirectory)/../../..&quot;" />
  </Target>
  <Target Name="AuditPlmPrograms" AfterTargets="Build" Condition="'$(RunPlmProgramAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --plm-program-audit --root &quot;$(MSBuildProjectDirectory)/../../..&quot;" />
  </Target>
  <Target Name="AuditQueuedVramDma" AfterTargets="Build" Condition="'$(RunQueuedVramDmaAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --vram-dma-audit --root &quot;$(MSBuildProjectDirectory)/../../..&quot;" />
  </Target>
  <Target Name="AuditEnemyVisualPrograms" AfterTargets="Build" Condition="'$(RunEnemyVisualProgramAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --enemy-visual-program-audit &quot;$(MSBuildProjectDirectory)/../../..&quot; &quot;$(MSBuildProjectDirectory)/../../../out/enemy-visual-program-audit.json&quot;" />
  </Target>
  <Target Name="AuditDoorCatalog" AfterTargets="Build" Condition="'$(RunDoorCatalogAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --door-catalog-audit &quot;$(MSBuildProjectDirectory)/../../..&quot; &quot;$(MSBuildProjectDirectory)/../../../out/door-catalog-audit.json&quot;" />
  </Target>
</Project>
