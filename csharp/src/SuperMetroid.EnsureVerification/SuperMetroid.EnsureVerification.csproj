<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SuperMetroid.Core/SuperMetroid.Core.csproj" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the analyzer sources under the analyzer-only project reference supplied by
         Directory.Build.targets so the analyzer enforces documentation on its own code. -->
    <Compile Include="../SuperMetroid.EnsureAnalyzer/*.cs"
             Link="AnalyzerSource/%(Filename)%(Extension)" />
    <Compile Include="../../test-support/VerificationAccess/PrivateState.cs" Link="TestSupport/VerificationAccess/PrivateState.cs" />
  </ItemGroup>
</Project>
