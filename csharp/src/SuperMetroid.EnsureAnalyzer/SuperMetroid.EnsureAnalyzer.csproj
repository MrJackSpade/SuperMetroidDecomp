<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compiler extensions target netstandard2.0 so every compiler host can load them (RS1041). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <!-- A package, not a path into one host's install: Visual Studio's MSBuild has no SDK Roslyn/bincore folder. The
         version must not exceed the oldest compiler that loads this analyzer (SDK 10.0.401 ships Roslyn 5.9). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <!-- netstandard2.0 has no System.Text.Json; .NET compiler hosts supply the assembly from their shared framework. -->
    <PackageReference Include="System.Text.Json" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
