  "coreLayers": [
    { "name": "Geometry", "modules": ["Spatial"],
      "description": "Coordinate spaces, extents, units and the cartridge's fixed-point number formats." },
    { "name": "Foundation", "modules": ["Compatibility", "Input", "Audio", "Programs", "Assets"],
      "description": "Compatibility services reproducing gameplay-observable timing of the original hardware, controller input, the SPC driver, shared instruction-program machinery and installed-artwork infrastructure. No gameplay knowledge." },
