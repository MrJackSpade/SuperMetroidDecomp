<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Retain the console subsystem so managed and native startup failures are printed to the
      launching terminal instead of being reduced to focus-stealing Windows error dialogs.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Let client-size changes reflect each monitor's physical pixels; the GPU
         still composes the same native 256x224 frame and owns final scaling. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SuperMetroid.Desktop/SuperMetroid.Desktop.csproj" />
    <Content Include="../SuperMetroid.Core/Frontend/SuperMetroid.defaults.ini"
             Link="SuperMetroid.defaults.ini" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
