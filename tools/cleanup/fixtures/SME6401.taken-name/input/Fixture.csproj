<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cleanup fixture (tools/cleanup/check-fixtures.ps1): the 2026-11-15 failure. The generic Behavior<TMotion> in
       MotionBehavior.cs shares its non-generic base's name, so the file name SME6401 wants (Behavior.cs) is taken and
       the fixer refuses. The run must record the site as unfixed and finish, changing nothing (the owner's ruling:
       the cleanup never fails over a fix). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(CleanupAnalyzer)" />
    <Analyzer Include="$(CleanupCodeFixes)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Behavior.cs" />
    <Compile Include="MotionBehavior.cs" />
  </ItemGroup>
</Project>
