<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- IDE-prefixed rules only run during a build with this set; without it the .editorconfig
         quality gates (#142) reach Visual Studio instead of failing the build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- LibraryImport source generators emit unsafe pointer stubs behind the managed API. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The compiler warnings the asynchronous cleanup fixes (csharp/.editorconfig, the group under its comment) are not
         listed here: they are none there, so the build neither reports nor fails on them. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS1591;CS1570;CS1572;CS1573;CS1574;CS1580;CS1584;CS1587;CS1658;CS0652;CS0675;CS8509;CS8524;CS0649;CS1717;CS0665;CS0252;CS0253;CS0108</WarningsAsErrors>
  </PropertyGroup>
</Project>
