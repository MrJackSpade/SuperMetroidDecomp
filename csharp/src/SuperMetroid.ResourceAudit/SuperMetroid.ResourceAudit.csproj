<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SuperMetroid.Core/SuperMetroid.Core.csproj" />
    <ProjectReference Include="../SuperMetroid.Tooling/SuperMetroid.Tooling.csproj" />
    <ProjectReference Include="../SuperMetroid.AssetExtraction/SuperMetroid.AssetExtraction.csproj" />
    <Compile Include="../../test-support/CpuBusTestDoubles/SyntheticCartridge.cs" Link="TestSupport/CpuBusTestDoubles/SyntheticCartridge.cs" />
    <!-- A package, not a path into one host's install: Visual Studio's MSBuild has no SDK Roslyn/bincore folder. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
  <Target Name="AuditResourceReferences" AfterTargets="Build" Condition="'$(RunResourceAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --root &quot;$(MSBuildProjectDirectory)/../../..&quot;" />
  </Target>
  <Target Name="AuditQueuedVramDma" AfterTargets="Build" Condition="'$(RunQueuedVramDmaAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --vram-dma-audit --root &quot;$(MSBuildProjectDirectory)/../../..&quot;" />
  </Target>
  <Target Name="AuditEnemyVisualPrograms" AfterTargets="Build" Condition="'$(RunEnemyVisualProgramAudit)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --enemy-visual-program-audit &quot;$(MSBuildProjectDirectory)/../../..&quot; &quot;$(MSBuildProjectDirectory)/../../../out/enemy-visual-program-audit.json&quot;" />
  </Target>
</Project>
