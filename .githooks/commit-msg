#!/bin/sh
# Reject commits that name Claude/Anthropic or are attributed to Codex/OpenAI.
set -eu
. "$(dirname "$0")/attribution-guard.sh"

if ! { git var GIT_AUTHOR_IDENT; git var GIT_COMMITTER_IDENT; git stripspace --strip-comments < "$1"; } | reject_blocked_names; then
    echo 'Commit blocked: the lines above carry AI vendor attribution.' >&2
    exit 1
fi
