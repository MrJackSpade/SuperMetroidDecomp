<Project Sdk="Microsoft.NET.Sdk">
  <!-- The source generators every project runs: debugger save states (StateGraph), the verification command registry,
       the build identity, named members and generated text. -->
  <PropertyGroup>
    <!-- Compiler extensions target netstandard2.0 so every compiler host can load them. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- A package, not a path into one host's install: Visual Studio's MSBuild has no SDK Roslyn/bincore folder. The
         version must not exceed the oldest compiler that loads these generators (SDK 10.0.401 ships Roslyn 5.9). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
