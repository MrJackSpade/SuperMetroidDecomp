<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cleanup fixture (tools/cleanup/check-fixtures.ps1): built beside the repository's csharp/.editorconfig, with a
       Directory.Build.props that imports csharp/Directory.Build.props and names the repository's analyzer and fixes.
       Its sources are listed explicitly, here and in Shared.projitems, so a renamed file's items must follow it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(CleanupAnalyzer)" />
    <Analyzer Include="$(CleanupCodeFixes)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Widget.cs" Link="Shapes/Widget.cs" />
  </ItemGroup>
  <Import Project="Shared.projitems" />
</Project>
