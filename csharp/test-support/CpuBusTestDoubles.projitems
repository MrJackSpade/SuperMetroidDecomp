    <Compile Include="$(MSBuildThisFileDirectory)CpuBusTestDoubles/CpuBusRegionRead.cs" Link="TestSupport/CpuBusTestDoubles/CpuBusRegionRead.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)CpuBusTestDoubles/SyntheticCartridge.cs" Link="TestSupport/CpuBusTestDoubles/SyntheticCartridge.cs" />
  </ItemGroup>
</Project>
