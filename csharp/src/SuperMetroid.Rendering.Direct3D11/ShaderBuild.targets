<Project>
  <PropertyGroup>
    <ShaderCompiler>$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.0.26100.0\x64\fxc.exe</ShaderCompiler>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every shader source and include, whose change compiles the shaders again. -->
    <DisplayShaderSource Include="$(MSBuildProjectDirectory)\Shaders\*.hlsl;$(MSBuildProjectDirectory)\Shaders\*.hlsli" />
  </ItemGroup>
  <!-- Incremental: the shaders compile again only when a shader source or this file changes, so a build or a design-time
       load of an unchanged project does not run the compiler seven times. A skipped target still adds its items. -->
  <Target Name="CompileDisplayShaders" BeforeTargets="PrepareForBuild"
          Inputs="@(DisplayShaderSource);$(MSBuildThisFileFullPath)"
          Outputs="$(IntermediateOutputPath)Shaders\ScreenGradient.cso;$(IntermediateOutputPath)Shaders\Solid.cso;$(IntermediateOutputPath)Shaders\Tiles.cso;$(IntermediateOutputPath)Shaders\SpriteVertex.cso;$(IntermediateOutputPath)Shaders\SpritePixel.cso;$(IntermediateOutputPath)Shaders\DisplayVertex.cso;$(IntermediateOutputPath)Shaders\DisplayPixel.cso">
    <Error Condition="!Exists('$(ShaderCompiler)')" Text="Install Windows SDK 10.0.26100.0 x64 shader compiler; see D3D11_BUILD.md." />
    <MakeDir Directories="$(IntermediateOutputPath)Shaders" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T cs_5_0 /E ScreenGradientMain /Fo &quot;$(IntermediateOutputPath)Shaders\ScreenGradient.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\ScreenGradient.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T cs_5_0 /E Main /Fo &quot;$(IntermediateOutputPath)Shaders\Solid.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Solid.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T cs_5_0 /E Main /Fo &quot;$(IntermediateOutputPath)Shaders\Tiles.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Tiles.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T vs_5_0 /E SpriteQuad /Fo &quot;$(IntermediateOutputPath)Shaders\SpriteVertex.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Sprites.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T ps_5_0 /E SpritePixel /Fo &quot;$(IntermediateOutputPath)Shaders\SpritePixel.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Sprites.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T vs_5_0 /E Vertex /Fo &quot;$(IntermediateOutputPath)Shaders\DisplayVertex.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Display.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /Ges /WX /O3 /T ps_5_0 /E Pixel /Fo &quot;$(IntermediateOutputPath)Shaders\DisplayPixel.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\Display.hlsl&quot;" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)Shaders\ScreenGradient.cso" Link="Shaders\ScreenGradient.cso" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(IntermediateOutputPath)Shaders\SpriteVertex.cso" Link="Shaders\SpriteVertex.cso" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(IntermediateOutputPath)Shaders\SpritePixel.cso" Link="Shaders\SpritePixel.cso" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(IntermediateOutputPath)Shaders\DisplayVertex.cso" Link="Shaders\DisplayVertex.cso" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(IntermediateOutputPath)Shaders\DisplayPixel.cso" Link="Shaders\DisplayPixel.cso" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(IntermediateOutputPath)Shaders\Solid.cso" Link="Shaders\Solid.cso" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(IntermediateOutputPath)Shaders\Tiles.cso" Link="Shaders\Tiles.cso" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
