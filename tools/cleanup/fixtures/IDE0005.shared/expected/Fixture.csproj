<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cleanup fixture (tools/cleanup/check-fixtures.ps1): built beside the repository's csharp/.editorconfig, with a
       Directory.Build.props that imports csharp/Directory.Build.props. Its shared files are compiled by Other.csproj
       too, which lacks this project's global using of Fixture.Shapes, as Verification lacks the global usings of
       DesktopVerification, IntegrationVerification and RenderVerification (#2607). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Fixture.Shapes" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Other/Other.csproj" />
  </ItemGroup>
  <Import Project="Shared.projitems" />
</Project>
